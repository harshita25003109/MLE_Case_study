        "\n",
        "db_sil = np.nan\n",
        "db_db = np.nan\n",
        "db_ch = np.nan\n",
        "if db_cluster_count >= 2 and non_noise.sum() > db_cluster_count:\n",
        "    db_sil = silhouette_score(X_scaled[non_noise], db_labels[non_noise])\n",
        "    db_db = davies_bouldin_score(X_scaled[non_noise], db_labels[non_noise])\n",
